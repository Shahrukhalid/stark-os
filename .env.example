# STARK OS configuration.
# Docker Compose can start without a .env file.
# For manual configuration, copy this file to .env
# or run: python scripts/setup.py
# Never commit real API keys or tokens.

# --- Authentication -------------------------------------------------------
# Optional: Docker automatically generates a secure token if unset.
# The generated token persists in the stark-data Docker volume.
# Retrieve it using:
# docker compose exec api cat /app/data/api-token
# Existing tokens supplied through .env take precedence.
STARK_API_TOKEN=

# --- Language models: free OpenRouter models only -----------------------------
# Get a free key at https://openrouter.ai/keys (no payment needed).
# A free key allows 50 free-model requests per day; a one-time $10 credit raises it to 1000/day.
OPENROUTER_API_KEY=
# Optional: pin a model for every tier, or per tier. Leave empty for automatic selection + failover.
# See the dashboard's Models panel for the current list of free models.
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_MODEL_DEEP=
# OPENROUTER_MODEL_BALANCED=
# OPENROUTER_MODEL_FAST=
# Safety net: STARK OS never calls paid models unless this is true.
# OPENROUTER_ALLOW_PAID=false

# --- Budgets & safety -----------------------------------------------------
# STARK_TASK_TOKEN_BUDGET=200000
# STARK_MAX_DELEGATION_DEPTH=2
# STARK_APPROVAL_TIMEOUT_S=480   (keep below the agents' task timeouts, 600 s+)
# observe | assist | execute_approved
STARK_DEFAULT_MODE=assist

# Brand folders agents may read/organise (guidelines, assets, briefs). Comma-separated. Default: ./sandbox
# STARK_WORKSPACE_ROOTS=./sandbox

# --- Social platforms (optional) -------------------------------------------
# Not configured = SIMULATION: drafts, checks and scheduling work, publishing is labelled SIMULATED.
# Every real publish still needs your approval in the dashboard.
# Bluesky: create an App Password (Settings -> Privacy and security -> App passwords). Never use your main password.
# BLUESKY_HANDLE=yourbrand.bsky.social
# BLUESKY_APP_PASSWORD=
# BLUESKY_SERVICE=https://bsky.social
# Mastodon: Preferences -> Development -> New application (scopes: read, write:statuses). https only.
# MASTODON_BASE_URL=https://mastodon.social
# MASTODON_ACCESS_TOKEN=
# Words that must never appear in a post (comma-separated); the policy check fails on them.
# STARK_BRAND_BLOCKED_TERMS=
# How often (seconds) approved scheduled posts are checked, and how late (hours) one may go out after STARK OS was
# off before it needs your approval again.
# STARK_SCHEDULER_INTERVAL_S=30
# STARK_SCHEDULER_GRACE_H=6

# --- Memory ---------------------------------------------------------------
# STARK_MEMORY_ENABLED=true
# STARK_EPISODIC_MEMORY=true
# STARK_EPISODIC_TTL_DAYS=30

# --- Research for Jocasta (optional; without one, web search reports "requires credentials") ---
# TAVILY_API_KEY=
# BRAVE_API_KEY=



# --- Docker Compose -------------------------------------------------------
# STARK OS uses SQLite by default.
# Application data persists in the Docker named volume "stark-data".
#
# First-time Docker startup (no .env required):
#   docker compose up -d --build
#
# If STARK_API_TOKEN is unset, Docker automatically generates
# a secure token and stores it in the persistent data volume.
#
# Retrieve the automatically generated token:
#   docker compose exec api cat /app/data/api-token
#
# Optional manual configuration:
#   python scripts/setup.py
#
# Production-hardened deployment:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Optional PostgreSQL:
# Set POSTGRES_PASSWORD and configure DATABASE_URL before enabling
# the postgres profile:
#   docker compose --profile postgres up -d
#
# SQLite remains the default unless DATABASE_URL is configured.
# Redis is not required for the default deployment.
# Never commit .env or real credentials to version control.



# --- Server ---------------------------------------------------------------
# Ports used by `make dev`. Change them if 3000/8000 are taken by another project.
# STARK_WEB_PORT=3000
# STARK_PORT=8000
# STARK_HOST=127.0.0.1
# STARK_WEB_ORIGIN=http://localhost:3000   (make dev sets this from STARK_WEB_PORT)
# STARK_DATA_DIR=./data
# STARK_AGENTS_DIR=./agents
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default database: <repo>/data/stark.db (SQLite). Uncomment only to use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://stark:CHANGE_ME@localhost:5432/stark
# POSTGRES_PASSWORD=

# Optional: use an installed Chrome/Chromium for the browser.render tool instead of Playwright's download.
# STARK_CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# --- Phone notifications (optional) ---
# Telegram: create a bot with @BotFather, send it any message, then put your chat id here. Approvals, new drafts
# and urgent mentions arrive with buttons (Approve / Reject, Publish / Discard). Only this chat can press them.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Discord: a channel webhook URL (Channel settings -> Integrations -> Webhooks). Messages only, no buttons.
# DISCORD_WEBHOOK_URL=
# Hour (0-23, this computer's time) of the daily digest.
# STARK_DIGEST_HOUR=9

# --- Growth ---
# Free AI images for posts (Pollinations, no key; the prompt leaves your computer). Set to "off" to disable.
# STARK_IMAGE_GENERATOR=pollinations
# Social listening (keywords, hashtags, competitor accounts on Bluesky and Mastodon). false = off.
# STARK_LISTENING=true

# --- Automation apps (optional) ---
# Webhooks for automation apps or your own server (comma-separated https URLs). Events: post.drafted,
# post.scheduled, post.published, post.failed, mention.found, approval.needed, autopilot.alert, estop.
# STARK_WEBHOOK_URLS=
# Signs each call: header X-Stark-Signature = "sha256=" + HMAC-SHA256(body, secret).
# STARK_WEBHOOK_SECRET=

# --- More places to publish (optional, all free) ---
# Threads: a Threads user access token (threads_basic + threads_content_publish) and your Threads user id.
# THREADS_ACCESS_TOKEN=
# THREADS_USER_ID=
# Telegram channel: add your bot (TELEGRAM_BOT_TOKEN above) as a channel admin, then @channelname or -100… here.
# TELEGRAM_CHANNEL_ID=
# Facebook Page you manage: your own Meta app (no review needed for your own Pages); Page access token with
# pages_manage_posts + pages_read_engagement, and the Page ID.
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_TOKEN=
# LinkedIn (your own profile): developer app with the free "Share on LinkedIn" and "Sign In with LinkedIn using
# OpenID Connect" products; token with openid, profile, w_member_social (expires after 60 days).
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AUTHOR_URN=      # optional, urn:li:person:...
# LINKEDIN_API_VERSION=202609
# Discord channel: Channel settings -> Integrations -> Webhooks -> New webhook -> Copy URL.
# DISCORD_POST_WEBHOOK_URL=
# Slack channel: an incoming webhook URL (api.slack.com/messaging/webhooks).
# SLACK_WEBHOOK_URL=
# Tag links in every new draft with utm_source / utm_medium / utm_campaign (click tracking in your web analytics).
# STARK_UTM=false
