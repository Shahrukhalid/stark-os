# STARK OS configuration. Copy to .env (or run: python3 scripts/setup.py).
# .env is git-ignored. Never commit real keys.

# --- Required -------------------------------------------------------------
# Random token the dashboard uses to talk to the API. scripts/setup.py fills this in.
STARK_API_TOKEN=

# --- Language models: free OpenRouter models only -----------------------------
# Get a free key at https://openrouter.ai/keys (no payment needed).
# A free key allows 50 free-model requests per day; a one-time $10 credit raises it to 1000/day.
OPENROUTER_API_KEY=
# Optional: pin a model for every tier, or per tier. Leave empty for automatic selection + failover.
# See the dashboard's Models panel for the current list of free models.
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_MODEL_DEEP=
# OPENROUTER_MODEL_BALANCED=
# OPENROUTER_MODEL_FAST=
# Safety net: STARK OS never calls paid models unless this is true.
# OPENROUTER_ALLOW_PAID=false

# --- Budgets & safety -----------------------------------------------------
# STARK_TASK_TOKEN_BUDGET=200000
# STARK_MAX_DELEGATION_DEPTH=2
# STARK_APPROVAL_TIMEOUT_S=480   (keep below the agents' task timeouts, 600 s+)
# observe | assist | execute_approved
STARK_DEFAULT_MODE=assist

# Brand folders agents may read/organise (guidelines, assets, briefs). Comma-separated. Default: ./sandbox
# STARK_WORKSPACE_ROOTS=./sandbox

# --- Social platforms (optional) -------------------------------------------
# Not configured = SIMULATION: drafts, checks and scheduling work, publishing is labelled SIMULATED.
# Every real publish still needs your approval in the dashboard.
# Bluesky: create an App Password (Settings -> Privacy and security -> App passwords). Never use your main password.
# BLUESKY_HANDLE=yourbrand.bsky.social
# BLUESKY_APP_PASSWORD=
# BLUESKY_SERVICE=https://bsky.social
# Mastodon: Preferences -> Development -> New application (scopes: read, write:statuses). https only.
# MASTODON_BASE_URL=https://mastodon.social
# MASTODON_ACCESS_TOKEN=
# Words that must never appear in a post (comma-separated); the policy check fails on them.
# STARK_BRAND_BLOCKED_TERMS=
# How often (seconds) approved scheduled posts are checked, and how late (hours) one may go out after STARK OS was
# off before it needs your approval again.
# STARK_SCHEDULER_INTERVAL_S=30
# STARK_SCHEDULER_GRACE_H=6

# --- Memory ---------------------------------------------------------------
# STARK_MEMORY_ENABLED=true
# STARK_EPISODIC_MEMORY=true
# STARK_EPISODIC_TTL_DAYS=30

# --- Research for Jocasta (optional; without one, web search reports "requires credentials") ---
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# --- Server ---------------------------------------------------------------
# Ports used by `make dev`. Change them if 3000/8000 are taken by another project.
# STARK_WEB_PORT=3000
# STARK_PORT=8000
# STARK_HOST=127.0.0.1
# STARK_WEB_ORIGIN=http://localhost:3000   (make dev sets this from STARK_WEB_PORT)
# STARK_DATA_DIR=./data
# STARK_AGENTS_DIR=./agents
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default database: <repo>/data/stark.db (SQLite). Uncomment only to use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://stark:CHANGE_ME@localhost:5432/stark
# POSTGRES_PASSWORD=

# Optional: use an installed Chrome/Chromium for the browser.render tool instead of Playwright's download.
# STARK_CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# --- Phone notifications (optional) ---
# Telegram: create a bot with @BotFather, send it any message, then put your chat id here. Approvals, new drafts
# and urgent mentions arrive with buttons (Approve / Reject, Publish / Discard). Only this chat can press them.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Discord: a channel webhook URL (Channel settings -> Integrations -> Webhooks). Messages only, no buttons.
# DISCORD_WEBHOOK_URL=
# Hour (0-23, this computer's time) of the daily digest.
# STARK_DIGEST_HOUR=9

# --- Growth ---
# Free AI images for posts (Pollinations, no key; the prompt leaves your computer). Set to "off" to disable.
# STARK_IMAGE_GENERATOR=pollinations
# Social listening (keywords, hashtags, competitor accounts on Bluesky and Mastodon). false = off.
# STARK_LISTENING=true
